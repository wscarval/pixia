# Configuração de desenvolvimento. O serviço fica em profile "turn" e NÃO é necessário
# para o primeiro teste em localhost.
listening-port=3478
fingerprint
realm=local.webrtc
# Credencial de longa duração (usuário/senha fixos) trocada por credencial
# efêmera: o backend gera usuário/senha de curta duração por sessão via
# GET /api/turn-credentials, usando este mesmo segredo pra assinar (HMAC-SHA1).
# Troque este valor e defina TURN_SECRET=<mesmo valor> no .env do backend.
use-auth-secret
static-auth-secret=123123
stale-nonce
no-cli
no-tls
no-dtls
no-multicast-peers
min-port=49160
max-port=49200
# Em produção (atrás de Docker/NAT), o coturn precisa saber seu IP público
# de verdade pra anunciar nos candidatos de relay — sem isso, ele anuncia o
# IP interno do container e o TURN simplesmente não funciona pra ninguém de
# fora. Descomente e preencha com o IP público do servidor:
external-ip=127.0.0.1
log-file=stdout
simple-log
