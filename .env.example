# Segredo usado para assinar os tokens de sessão (JWT) das contas de usuário.
# Troque por um valor longo e aleatório antes de qualquer uso real.
JWT_SECRET=troque-este-segredo

# Credenciais do Postgres usado pelo backend (via Prisma).
# Troque a senha antes de qualquer uso real.
POSTGRES_USER=webrtc
POSTGRES_PASSWORD=webrtc
POSTGRES_DB=webrtc_meeting

# Origem(ns) permitida(s) para o Socket.IO (CORS), separadas por vírgula.
# Vazio: nenhuma origem cruzada é aceita por padrão (o próprio app sempre
# fala pela mesma origem via Nginx, então isso não afeta o uso normal).
# Só preencha se outro domínio realmente precisar abrir conexão direto.
# CORS_ORIGIN=https://pixiaart.com

# Para localhost, STUN é suficiente para o primeiro teste.
VITE_STUN_URL=stun:stun.cloudflare.com:3478

# TURN fica desativado no primeiro teste local.
VITE_TURN_ENABLED=false

# TURN_SECRET precisa ser IGUAL ao "static-auth-secret" de
# coturn/turnserver.conf — o backend usa esse segredo pra gerar uma
# credencial de TURN de curta duração (1h) por sessão, em vez de uma fixa
# exposta pra sempre no bundle do cliente. TURN_URL é o endereço público do
# coturn que o navegador vai usar.
# TURN_SECRET=troque-este-segredo-turn
# TURN_URL=turn:SEU_IP_OU_DOMINIO:3478?transport=udp
