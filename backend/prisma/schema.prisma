generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  avatarId     Int      @default(1) @map("avatar_id")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  rooms        Room[]
  roomVisits   RoomVisit[]
  roomBans     RoomBan[]

  @@map("users")
}

model Room {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String?
  passwordHash String?  @map("password_hash")
  ownerId      String?  @map("owner_id")
  owner        User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime? @map("expires_at")
  creatorIp    String?  @map("creator_ip")
  chatMessages ChatMessage[]
  visits       RoomVisit[]
  bans         RoomBan[]

  @@index([creatorIp])
  @@map("rooms")
}

// Histórico de "essa conta já entrou nessa sala" — só para quem está
// logado (visitante anônimo não tem onde guardar isso entre sessões).
// Usado pra listar "Salas Acessadas Anteriormente" na tela inicial e no
// painel, separado das salas que a própria conta criou.
model RoomVisit {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId        String   @map("room_id")
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  lastVisitedAt DateTime @default(now()) @map("last_visited_at")

  @@unique([userId, roomId])
  @@index([userId, lastVisitedAt])
  @@map("room_visits")
}

// Histórico de chat de toda sala (pública/anônima ou não) — some sozinho
// quando a sala é apagada (cascade), inclusive salas anônimas expiradas.
model ChatMessage {
  id            String   @id @default(uuid())
  roomId        String   @map("room_id")
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userName      String   @map("user_name")
  userAvatarId  Int?     @map("user_avatar_id")
  userAvatarUrl String?  @map("user_avatar_url")
  message       String
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

// Expulsão (não fica registrada, só derruba o socket) x banimento (fica
// registrado aqui, bloqueia join-room futuro nessa sala). Conta logada
// banida por userId; visitante anônimo por guestId (um UUID persistido no
// localStorage do navegador dele, não por IP — banir por IP bloquearia
// qualquer outra pessoa na mesma rede/NAT junto, o que já foi rejeitado
// antes nesse projeto pra outro uso). Cada linha é UM tipo de identidade
// banida; os dois índices UNIQUE de baixo garantem que não duplica.
model RoomBan {
  id         String   @id @default(uuid())
  roomId     String   @map("room_id")
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId    String?  @map("guest_id")
  bannedName String   @map("banned_name")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([roomId, userId])
  @@unique([roomId, guestId])
  @@index([roomId])
  @@map("room_bans")
}
